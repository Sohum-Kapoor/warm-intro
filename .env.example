# Copy to .env and fill in. Never commit .env.

# mock = offline and deterministic (default). watsonx = IBM Granite on watsonx.ai.
LLM_PROVIDER=mock

# From the hackathon IBM Cloud account. Copy each value from the watsonx.ai project;
# do not guess them.
WATSONX_APIKEY=
WATSONX_URL=
WATSONX_PROJECT_ID=
WATSONX_CHAT_MODEL=
WATSONX_EMBED_MODEL=
